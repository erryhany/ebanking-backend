# Copier ce fichier en .env puis remplacer les valeurs (le fichier .env n'est jamais commité).

# Clé de signature des JWT (HS512) : au moins 64 caractères.
# Générer avec : openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Mot de passe de l'utilisateur root MySQL (utilisé par docker compose et par le backend)
DB_PASSWORD=

# Utiles seulement pour lancer le backend hors Docker (valeurs par défaut indiquées)
# DB_URL=jdbc:mysql://localhost:3306/E-BANK?createDatabaseIfNotExist=true
# DB_USERNAME=root
